<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="five_rooms_with_robot">
    <include>
      <uri>model://sun</uri>
    </include>

    <!-- Серый пол -->
    <model name="ground_plane">
      <static>true</static>
      <link name="ground_link">
        <collision name="ground_collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
        </collision>
        <visual name="ground_visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.5 0.5 0.5 1</ambient>
            <diffuse>0.5 0.5 0.5 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Здание -->
    <model name="building">
      <static>true</static>

      <!-- Внешние стены -->
      <link name="wall_back">
        <pose>0 -5 1.25 0 0 0</pose>
        <visual name="wall_back_visual">
          <geometry><box><size>12.2 0.2 2.5</size></box></geometry>
          <material><ambient>1 1 1 1</ambient></material>
        </visual>
        <collision name="wall_back_collision">
          <geometry><box><size>12.2 0.2 2.5</size></box></geometry>
        </collision>
      </link>
      <link name="wall_front">
        <pose>0 5 1.25 0 0 0</pose>
        <visual name="wall_front_visual">
          <geometry><box><size>12.2 0.2 2.5</size></box></geometry>
          <material><ambient>1 1 1 1</ambient></material>
        </visual>
        <collision name="wall_front_collision">
          <geometry><box><size>12.2 0.2 2.5</size></box></geometry>
        </collision>
      </link>
      <link name="wall_left">
        <pose>-6 0 1.25 0 0 0</pose>
        <visual name="wall_left_visual">
          <geometry><box><size>0.2 10.2 2.5</size></box></geometry>
          <material><ambient>1 1 1 1</ambient></material>
        </visual>
        <collision name="wall_left_collision">
          <geometry><box><size>0.2 10.2 2.5</size></box></geometry>
        </collision>
      </link>
      <link name="wall_right">
        <pose>6 0 1.25 0 0 0</pose>
        <visual name="wall_right_visual">
          <geometry><box><size>0.2 10.2 2.5</size></box></geometry>
          <material><ambient>1 1 1 1</ambient></material>
        </visual>
        <collision name="wall_right_collision">
          <geometry><box><size>0.2 10.2 2.5</size></box></geometry>
        </collision>
      </link>

      <!-- Разделительные стены -->
      <link name="left_divider">
        <pose>-3.5 0 1.25 0 0 0</pose>
        <visual name="left_divider_visual">
          <geometry><box><size>5 0.2 2.5</size></box></geometry>
          <material><ambient>1 1 1 1</ambient></material>
        </visual>
        <collision name="left_divider_collision">
          <geometry><box><size>5 0.2 2.5</size></box></geometry>
        </collision>
      </link>
      <link name="right_divider_top">
        <pose>3.5 2 1.25 0 0 0</pose>
        <visual name="right_divider_top_visual">
          <geometry><box><size>5 0.2 2.5</size></box></geometry>
          <material><ambient>1 1 1 1</ambient></material>
        </visual>
        <collision name="right_divider_top_collision">
          <geometry><box><size>5 0.2 2.5</size></box></geometry>
        </collision>
      </link>
      <link name="right_divider_bottom">
        <pose>3.5 -2 1.25 0 0 0</pose>
        <visual name="right_divider_bottom_visual">
          <geometry><box><size>5 0.2 2.5</size></box></geometry>
          <material><ambient>1 1 1 1</ambient></material>
        </visual>
        <collision name="right_divider_bottom_collision">
          <geometry><box><size>5 0.2 2.5</size></box></geometry>
        </collision>
      </link>

      <!-- Стены коридора с проёмами -->
      <link name="corr_left_top">
        <pose>-1 3 1.25 0 0 0</pose>
        <visual name="corr_left_top_visual">
          <geometry><box><size>0.2 3.5 2.5</size></box></geometry>
          <material><ambient>1 1 1 1</ambient></material>
        </visual>
        <collision name="corr_left_top_collision">
          <geometry><box><size>0.2 3.5 2.5</size></box></geometry>
        </collision>
      </link>
      <link name="corr_left_mid">
        <pose>-1 0.5 1.25 0 0 0</pose>
        <visual name="corr_left_mid_visual">
          <geometry><box><size>0.2 1.2 2.5</size></box></geometry>
          <material><ambient>1 1 1 1</ambient></material>
        </visual>
        <collision name="corr_left_mid_collision">
          <geometry><box><size>0.2 1.2 2.5</size></box></geometry>
        </collision>
      </link>
      <link name="corr_left_bottom">
        <pose>-1 -3 1.25 0 0 0</pose>
        <visual name="corr_left_bottom_visual">
          <geometry><box><size>0.2 3.5 2.5</size></box></geometry>
          <material><ambient>1 1 1 1</ambient></material>
        </visual>
        <collision name="corr_left_bottom_collision">
          <geometry><box><size>0.2 3.5 2.5</size></box></geometry>
        </collision>
      </link>

      <link name="corr_right_top">
        <pose>1 3 1.25 0 0 0</pose>
        <visual name="corr_right_top_visual">
          <geometry><box><size>0.2 3.5 2.5</size></box></geometry>
          <material><ambient>1 1 1 1</ambient></material>
        </visual>
        <collision name="corr_right_top_collision">
          <geometry><box><size>0.2 3.5 2.5</size></box></geometry>
        </collision>
      </link>
      <link name="corr_right_mid">
        <pose>1 0.5 1.25 0 0 0</pose>
        <visual name="corr_right_mid_visual">
          <geometry><box><size>0.2 1.2 2.5</size></box></geometry>
          <material><ambient>1 1 1 1</ambient></material>
        </visual>
        <collision name="corr_right_mid_collision">
          <geometry><box><size>0.2 1.2 2.5</size></box></geometry>
        </collision>
      </link>
      <link name="corr_right_bottom">
        <pose>1 -3 1.25 0 0 0</pose>
        <visual name="corr_right_bottom_visual">
          <geometry><box><size>0.2 3.5 2.5</size></box></geometry>
          <material><ambient>1 1 1 1</ambient></material>
        </visual>
        <collision name="corr_right_bottom_collision">
          <geometry><box><size>0.2 3.5 2.5</size></box></geometry>
        </collision>
      </link>
    </model>

    <!-- Робот в центре левой верхней комнаты (x от -5 до -1, y от 0 до 5) -->
    <model name="robot">
      <pose>-3 2.5 0.05 0 0 0</pose>
      <link name="chassis">
        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>0.2</radius>
              <length>0.1</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>1 0 0 1</ambient>  <!-- красный -->
            <diffuse>1 0 0 1</diffuse>
          </material>
        </visual>
        <collision name="collision">
          <geometry>
            <cylinder>
              <radius>0.2</radius>
              <length>0.1</length>
            </cylinder>
          </geometry>
        </collision>
      </link>
    </model>

  </world>
</sdf>
