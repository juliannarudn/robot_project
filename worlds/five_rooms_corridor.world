      <link name="corr_right_mid"><pose>1 0.5 1.25 0 0 0</pose><visual><geometry><box><size>0.2 1.2 2.5</size></box></geometry><material><ambient>1 1 1 1</ambient></material></visual><collision><geometry><box><size>0.2 1.2 2.5</size></box></geometry></collision></link>
      <link name="corr_right_bottom"><pose>1 -3 1.25 0 0 0</pose><visual><geometry><box><size>0.2 3.5 2.5</size></box></geometry><material><ambient>1 1 1 1</ambient></material></visual><collision><geometry><box><size>0.2 3.5 2.5</size></box></geometry></collision></link>

    </model>
  </world>
</sdf>
