<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="five_rooms_corridor">

    <include>
      <uri>model://sun</uri>
    </include>

    <!-- Серый пол -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Здание -->
    <model name="building">
<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="five_rooms_corridor">
    <include>
      <uri>model://sun</uri>
    </include>

    <!-- Пол (серая плоскость) -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.5 0.5 0.5 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Здание -->
    <model name="building">
      <static>true</static>

      <!-- Внешние стены (белые) -->
      <link name="wall_back"><pose>0 -5 1.25 0 0 0</pose><visual><geometry><box><size>12.2 0.2 2.5</size></box></geometry><material><ambient>1 1 1 1</ambient></material></visual><collision><geometry><box><size>12.2 0.2 2.5</size></box></geometry></collision></link>
      <link name="wall_front"><pose>0 5 1.25 0 0 0</pose><visual><geometry><box><size>12.2 0.2 2.5</size></box></geometry><material><ambient>1 1 1 1</ambient></material></visual><collision><geometry><box><size>12.2 0.2 2.5</size></box></geometry></collision></link>
      <link name="wall_left"><pose>-6 0 1.25 0 0 0</pose><visual><geometry><box><size>0.2 10.2 2.5</size></box></geometry><material><ambient>1 1 1 1</ambient></material></visual><collision><geometry><box><size>0.2 10.2 2.5</size></box></geometry></collision></link>
      <link name="wall_right"><pose>6 0 1.25 0 0 0</pose><visual><geometry><box><size>0.2 10.2 2.5</size></box></geometry><material><ambient>1 1 1 1</ambient></material></visual><collision><geometry><box><size>0.2 10.2 2.5</size></box></geometry></collision></link>

      <!-- Разделительные стены между комнатами -->
      <link name="left_divider"><pose>-3.5 0 1.25 0 0 0</pose><visual><geometry><box><size>5 0.2 2.5</size></box></geometry><material><ambient>1 1 1 1</ambient></material></visual><collision><geometry><box><size>5 0.2 2.5</size></box></geometry></collision></link>
      <link name="right_divider_top"><pose>3.5 2 1.25 0 0 0</pose><visual><geometry><box><size>5 0.2 2.5</size></box></geometry><material><ambient>1 1 1 1</ambient></material></visual><collision><geometry><box><size>5 0.2 2.5</size></box></geometry></collision></link>
      <link name="right_divider_bottom"><pose>3.5 -2 1.25 0 0 0</pose><visual><geometry><box><size>5 0.2 2.5</size></box></geometry><material><ambient>1 1 1 1</ambient></material></visual><collision><geometry><box><size>5 0.2 2.5</size></box></geometry></collision></link>

      <!-- Стены коридора с проёмами -->
      <!-- Левая стена (три сегмента, между ними проёмы) -->
      <link name="corr_left_top"><pose>-1 3 1.25 0 0 0</pose><visual><geometry><box><size>0.2 3.5 2.5</size></box></geometry><material><ambient>1 1 1 1</ambient></material></visual><collision><geometry><box><size>0.2 3.5 2.5</size></box></geometry></collision></link>
      <link name="corr_left_mid"><pose>-1 0.5 1.25 0 0 0</pose><visual><geometry><box><size>0.2 1.2 2.5</size></box></geometry><material><ambient>1 1 1 1</ambient></material></visual><collision><geometry><box><size>0.2 1.2 2.5</size></box></geometry></collision></link>
      <link name="corr_left_bottom"><pose>-1 -3 1.25 0 0 0</pose><visual><geometry><box><size>0.2 3.5 2.5</size></box></geometry><material><ambient>1 1 1 1</ambient></material></visual><collision><geometry><box><size>0.2 3.5 2.5</size></box></geometry></collision></link>

      <!-- Правая стена (три сегмента) -->
      <link name="corr_right_top"><pose>1 3 1.25 0 0 0</pose><visual><geometry><box><size>0.2 3.5 2.5</size></box></geometry><material><ambient>1 1 1 1</ambient></material></visual><collision><geometry><box><size>0.2 3.5 2.5</size></box></geometry></collision></link>
      <link name="corr_right_mid"><pose>1 0.5 1.25 0 0 0</pose><visual><geometry><box><size>0.2 1.2 2.5</size></box></geometry><material><ambient>1 1 1 1</ambient></material></visual><collision><geometry><box><size>0.2 1.2 2.5</size></box></geometry></collision></link>
      <link name="corr_right_bottom"><pose>1 -3 1.25 0 0 0</pose><visual><geometry><box><size>0.2 3.5 2.5</size></box></geometry><material><ambient>1 1 1 1</ambient></material></visual><collision><geometry><box><size>0.2 3.5 2.5</size></box></geometry></collision></link>
    </model>
  </world>
